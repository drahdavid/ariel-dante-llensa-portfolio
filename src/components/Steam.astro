---
/*
  Vapor muy suave que sube sobre una foto (canvas). Se pausa fuera de pantalla y no corre con prefers-reduced-motion.
*/
interface Props {
  density?: number;
  class?: string;
}

const { density = 1, class: className } = Astro.props;
---

<canvas class:list={['steam', className]} data-steam data-density={density} aria-hidden="true"></canvas>

<style>
  .steam {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 2;
    opacity: 0.7;
  }
</style>

<script>
  interface P {
    x: number;
    y: number;
    vx: number;
    vy: number;
    life: number;
    max: number;
    r: number;
    seed: number;
  }

  // Sprite pre-dibujado: mucho más barato que un blur por partícula
  function sprite() {
    const size = 128;
    const c = document.createElement('canvas');
    c.width = c.height = size;
    const g = c.getContext('2d')!;
    const grd = g.createRadialGradient(size / 2, size / 2, 0, size / 2, size / 2, size / 2);
    grd.addColorStop(0, 'rgba(255,255,255,0.18)');
    grd.addColorStop(0.5, 'rgba(255,255,255,0.06)');
    grd.addColorStop(1, 'rgba(255,255,255,0)');
    g.fillStyle = grd;
    g.fillRect(0, 0, size, size);
    return c;
  }

  function run(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;
    const density = Number(canvas.dataset.density || 1);
    const img = sprite();
    let w = 0;
    let h = 0;
    let parts: P[] = [];
    let raf = 0;
    let last = 0;

    const spawn = (initial = false): P => {
      const max = 6 + Math.random() * 4;
      return {
        x: w * (0.3 + Math.random() * 0.4),
        y: initial ? h * Math.random() : h * (0.62 + Math.random() * 0.1),
        vx: (Math.random() - 0.5) * 5,
        vy: -(10 + Math.random() * 8),
        life: initial ? Math.random() * max : 0,
        max,
        r: 40 + Math.random() * 40,
        seed: Math.random() * 1000,
      };
    };

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(12 * density);
      while (parts.length < n) parts.push(spawn(true));
      parts.length = n;
    };

    const frame = (t: number) => {
      const dt = Math.min(0.05, (t - (last || t)) / 1000);
      last = t;
      ctx.clearRect(0, 0, w, h);
      for (let i = 0; i < parts.length; i++) {
        const p = parts[i];
        p.life += dt;
        if (p.life > p.max) {
          parts[i] = spawn();
          continue;
        }
        const k = p.life / p.max;
        p.x += (p.vx + Math.sin(t / 900 + p.seed) * 6) * dt;
        p.y += p.vy * dt;
        const s = p.r * (1 + k * 1.6);
        ctx.globalAlpha = Math.sin(Math.PI * k) * 0.8;
        ctx.drawImage(img, p.x - s, p.y - s, s * 2, s * 2);
      }
      ctx.globalAlpha = 1;
      raf = requestAnimationFrame(frame);
    };

    const start = () => {
      if (!raf) {
        last = 0;
        raf = requestAnimationFrame(frame);
      }
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    resize();
    new ResizeObserver(resize).observe(canvas);
    let inView = false;
    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        inView ? start() : stop();
      },
      { rootMargin: '100px' },
    ).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : inView && start()));
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-steam]').forEach(run);
  }
</script>
