---
/*
  Foto que se abre desde un corte: primero se traza una línea fina en el centro del marco
  y después la imagen se abre desde esa línea mientras se asienta (escala 1.12 → 1).
  dir="h": línea horizontal, abre hacia arriba y abajo.  dir="v": línea vertical, abre hacia los costados.
  trigger="load": al cargar.  trigger="scroll": una vez, al entrar en pantalla.
  Sin JS o con reduced-motion se ve la foto entera.
*/
import { Picture } from 'astro:assets';
import { imageFor, type Dish } from '../lib/dishes';
import type { Lang } from '../data/site';

interface Props {
  dish: Dish;
  lang: Lang;
  dir?: 'h' | 'v';
  trigger?: 'load' | 'scroll';
  ratio?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { dish, lang, dir = 'h', trigger = 'scroll', ratio = '4 / 5', sizes = '100vw', eager = false, class: className } = Astro.props;
---

<figure class:list={['cr', className]} data-reveal-cut={dir} data-reveal-trigger={trigger} style={`--ratio:${ratio}`}>
  <div class="cr__frame">
    <div class="cr__media">
      <Picture
        class="cr__img"
        src={imageFor(dish)}
        alt={dish.alt[lang]}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1280, 1600, 2000]}
        sizes={sizes}
        quality={70}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
      <slot />
    </div>
    <span class="cr__line" aria-hidden="true"></span>
  </div>
  <slot name="caption" />
</figure>

<style>
  .cr {
    position: relative;
    margin: 0;
  }
  .cr__frame {
    position: relative;
    aspect-ratio: var(--ratio);
  }
  .cr__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--surface);
  }
  .cr__media :global(img) {
    position: absolute;
    inset: -4% 0;
    width: 100%;
    height: 108%;
    object-fit: cover;
    will-change: transform;
  }
  .cr__line {
    display: none;
    position: absolute;
    background: linear-gradient(90deg, transparent, var(--accent) 20%, var(--fg) 50%, var(--accent) 80%, transparent);
    opacity: 0;
    pointer-events: none;
  }
  .cr[data-reveal-cut='h'] .cr__line {
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
  }
  .cr[data-reveal-cut='v'] .cr__line {
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(180deg, transparent, var(--accent) 20%, var(--fg) 50%, var(--accent) 80%, transparent);
  }

  /* Con animación, el marco arranca cerrado sobre la línea */
  :global(.js.motion) .cr[data-reveal-cut='h'] .cr__media {
    clip-path: inset(50% 0 50% 0);
  }
  :global(.js.motion) .cr[data-reveal-cut='v'] .cr__media {
    clip-path: inset(0 50% 0 50%);
  }
  :global(.js.motion) .cr .cr__line {
    display: block;
  }
</style>
