---
/*
  Trayectoria como menú degustación: una carta centrada, enmarcada en un doble filete.
  Cada trabajo es un tiempo; cierra con la formación.
*/
import CutTitle from './CutTitle.astro';
import { ui, jobs, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section id="trayectoria" class="section menu" aria-labelledby="menu-title">
  <div class="wrap">
    <div class="menu__card">
      <header class="menu__head">
        <p class="caps"><b class="menu__num">{t.menuKicker}</b></p>
        <CutTitle id="menu-title" text={t.menuTitle} class="menu__title" />
        <p class="menu__intro" data-reveal>{t.menuIntro}</p>
      </header>

      <ol class="menu__courses">
        {
          jobs.map((j, i) => (
            <li class="course">
              <span class="sep" data-rule aria-hidden="true" />
              <p class="caps" data-reveal>{t.courses[i]}</p>
              <h3 class="course__place" data-reveal="0.08">{j.place}</h3>
              <p class="course__role" data-reveal="0.14">
                {j.role[lang]} <span aria-hidden="true">·</span> {j.where[lang]}
              </p>
              <p class="course__items" data-reveal="0.2">{j.items.map((it) => it[lang]).join(' · ')}</p>
              <p class="course__dates caps" data-reveal="0.26">{j.dates[lang]}</p>
            </li>
          ))
        }
        <li class="course course--edu">
          <span class="sep" data-rule aria-hidden="true" />
          <p class="caps" data-reveal>{t.eduLabel}</p>
          <h3 class="course__place" data-reveal="0.08">{t.eduSchool}</h3>
          <p class="course__role" data-reveal="0.14">{t.eduTitle}</p>
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .menu__card {
    position: relative;
    max-width: 760px;
    margin-inline: auto;
    padding: clamp(56px, 8vw, 104px) clamp(24px, 6vw, 88px);
    text-align: center;
    border: 1px solid var(--rule);
  }
  /* Segundo filete, hacia adentro: el marco doble de una carta */
  .menu__card::before {
    content: '';
    position: absolute;
    inset: 8px;
    border: 1px solid var(--rule);
    pointer-events: none;
  }
  .menu__head {
    display: grid;
    justify-items: center;
    margin-bottom: clamp(48px, 6vw, 72px);
  }
  .menu__num {
    font-weight: 400;
    color: var(--accent);
  }
  .menu__head :global(.menu__title) {
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-style: italic;
    margin: 1.4rem 0 1.2rem;
  }
  .menu__intro {
    font: italic 300 clamp(1.1rem, 1.5vw, 1.3rem) / 1.4 var(--font-display);
    color: var(--fg-3);
    margin: 0;
  }
  .menu__courses {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(44px, 5vw, 64px);
  }
  .course {
    display: grid;
    justify-items: center;
  }
  .course .sep {
    margin-bottom: clamp(36px, 4vw, 52px);
  }
  .course .caps {
    margin-bottom: 0.9rem;
  }
  .course__place {
    font-size: clamp(2rem, 4vw, 2.7rem);
    font-weight: 400;
    margin-bottom: 0.6rem;
  }
  .course__role {
    font: italic 300 1.2rem/1.4 var(--font-display);
    color: var(--fg-2);
    margin-bottom: 0.8rem;
  }
  .course__role span {
    color: var(--accent);
    margin: 0 0.35em;
  }
  .course__items {
    max-width: 44ch;
    color: var(--fg-3);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }
  .course__dates {
    color: var(--accent);
    margin: 0;
  }
  .course--edu .course__place {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
  }
  .course--edu .course__role {
    margin: 0;
  }
</style>
