---
import { ui, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<header class="site-header">
  <div class="wrap site-header__in">
    <a class="brand caps" href={lang === 'es' ? '/' : '/en/'}>Ariel Dante Llensa</a>
    <nav class="nav" aria-label={lang === 'es' ? 'Secciones' : 'Sections'}>
      <a class="link caps" href="#perfil">{t.nav.about}</a>
      <a class="link caps" href="#platos">{t.nav.dishes}</a>
      <a class="link caps" href="#trayectoria">{t.nav.path}</a>
    </nav>
    <div class="site-header__end caps">
      <span class="lang">
        <a href="/" aria-current={lang === 'es' ? 'true' : undefined} hreflang="es" lang="es">ES</a>
        <span aria-hidden="true">/</span>
        <a href="/en/" aria-current={lang === 'en' ? 'true' : undefined} hreflang="en" lang="en">EN</a>
      </span>
      <a class="link contact-link" href="#contacto">{t.nav.contact}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    transition: background-color 0.6s, border-color 0.6s;
    border-bottom: 1px solid transparent;
  }
  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom-color: var(--rule);
  }
  .site-header__in {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    height: 72px;
  }
  .brand {
    color: var(--fg);
    text-decoration: none;
    letter-spacing: 0.28em;
  }
  .nav {
    display: none;
    gap: 2.6rem;
  }
  .nav a {
    color: var(--fg-2);
    transition: color 0.4s;
  }
  .nav a:hover {
    color: var(--fg);
  }
  .site-header__end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2rem;
  }
  .lang {
    display: inline-flex;
    gap: 0.5em;
  }
  .lang a {
    text-decoration: none;
    transition: color 0.4s;
  }
  .lang a[aria-current] {
    color: var(--fg);
  }
  .lang a:hover {
    color: var(--accent);
  }
  .contact-link {
    color: var(--fg);
  }
  /* En el header el subrayado sólo aparece al pasar */
  .site-header .link::after {
    opacity: 0;
  }
  .site-header .link:hover::after,
  .site-header .link:focus-visible::after {
    opacity: 1;
  }
  @media (max-width: 520px) {
    .brand {
      letter-spacing: 0.18em;
      font-size: 0.66rem;
    }
    .contact-link {
      display: none;
    }
  }
  @media (min-width: 960px) {
    .site-header__in {
      grid-template-columns: 1fr auto 1fr;
    }
    .nav {
      display: flex;
    }
  }
</style>
