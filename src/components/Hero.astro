---
import CutTitle from './CutTitle.astro';
import { ui, type Lang } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="hero" aria-labelledby="hero-name">
  <div class="hero__in">
    <p class="hero__eyebrow caps" data-spacing>{t.eyebrow}</p>
    <h1 id="hero-name" class="hero__name">
      <CutTitle as="span" text="Ariel" trigger="load" delay={0.3} />
      <CutTitle as="span" text="Dante" trigger="load" delay={0.6} class="hero__it" />
      <CutTitle as="span" text="Llensa" trigger="load" delay={0.9} />
    </h1>
    <span class="sep" data-reveal="1.8"></span>
    <p class="hero__lede" data-reveal="2">{t.lede}</p>
  </div>
  <a class="hero__scroll caps" href="#destacada" data-reveal="2.4">
    <span>{t.scroll}</span>
    <i aria-hidden="true"></i>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 110px var(--gutter) 120px;
    text-align: center;
    /* Una luz cálida muy tenue detrás del nombre */
    background: radial-gradient(ellipse 60% 50% at 50% 45%, rgb(176 141 98 / 0.08), transparent 70%);
  }
  .hero__in {
    display: grid;
    justify-items: center;
  }
  .hero__eyebrow {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .hero__name {
    display: grid;
    justify-items: center;
    /* Limitado también por el alto de la ventana, para que la tapa entre entera */
    font-size: clamp(3.8rem, min(13vw, 15svh), 9.5rem);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.015em;
    margin-bottom: clamp(2.2rem, 4vw, 3.2rem);
  }
  .hero__name :global(.ct) {
    padding-bottom: 0.06em;
  }
  .hero__name :global(.hero__it) {
    font-style: italic;
    font-weight: 300;
  }
  .hero__lede {
    margin: clamp(1.6rem, 3vw, 2.2rem) 0 0;
    font: italic 300 clamp(1.3rem, 2vw, 1.75rem) / 1.3 var(--font-display);
    color: var(--fg-2);
  }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 32px;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 14px;
    text-decoration: none;
  }
  .hero__scroll i {
    display: block;
    width: 1px;
    height: 56px;
    background: linear-gradient(var(--accent), transparent);
    transform-origin: top;
    animation: breathe 2.8s var(--ease-out) infinite;
  }
  @keyframes breathe {
    0% {
      transform: scaleY(0);
      opacity: 1;
    }
    60% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__scroll i {
      animation: none;
    }
  }
</style>
