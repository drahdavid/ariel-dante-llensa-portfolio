---
import { Image } from 'astro:assets';
import CutTitle from './CutTitle.astro';
import { ui, site, waUrl, igUrl, type Lang } from '../data/site';
import mwl from '../assets/mendoza-web-lab.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<section id="contacto" class="contact" aria-labelledby="contact-title">
  <div class="wrap contact__in">
    <p class="caps contact__label" data-reveal><b>{t.contactKicker}</b>{t.contactLabel}</p>
    <CutTitle id="contact-title" text={t.contactTitle} class="contact__title" />
    <p class="contact__body" data-reveal>{t.contactBody}</p>
    <a class="cta" href={waUrl(t.waText)} target="_blank" rel="noopener" data-reveal="0.1">{t.contactWa}</a>
    <ul class="contact__links" data-reveal="0.2">
      <li><a class="link" href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a class="link" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">+54 9 {site.phone}</a></li>
      <li>
        <a class="link" href={igUrl(site.instagram)} target="_blank" rel="noopener">Instagram</a>
        <span aria-hidden="true">·</span>
        <a class="link" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </li>
    </ul>
    <p class="caps contact__city">{site.city}</p>
  </div>

  <footer class="footer wrap caps">
    <span>© {year} {site.name}</span>
    <a class="footer__credit" href="https://mendozaweblab.com/" target="_blank" rel="noopener">
      {t.footerMade}
      <Image src={mwl} alt="Mendoza Web Lab" height={20} densities={[1, 2]} />
    </a>
  </footer>
</section>

<style>
  .contact {
    position: relative;
    background:
      radial-gradient(ellipse 50% 40% at 50% 30%, rgb(176 141 98 / 0.07), transparent 70%),
      var(--deep);
    padding-top: clamp(120px, 16vw, 240px);
    text-align: center;
  }
  .contact__in {
    display: grid;
    justify-items: center;
  }
  .contact__label b {
    font-weight: 400;
    color: var(--accent);
    margin-right: 1.2em;
  }
  .contact :global(.contact__title) {
    font-size: clamp(3.6rem, 11vw, 9rem);
    font-style: italic;
    font-weight: 300;
    margin: 1.8rem 0 2rem;
  }
  .contact__body {
    max-width: 38ch;
    font: 300 clamp(1.25rem, 1.8vw, 1.5rem) / 1.45 var(--font-display);
    color: var(--fg-2);
    margin-bottom: 2.6rem;
  }
  .contact__links {
    display: grid;
    gap: 0.8rem;
    list-style: none;
    margin: 3.4rem 0 0;
    padding: 0;
    font: 300 clamp(1.3rem, 2vw, 1.6rem) / 1.3 var(--font-display);
  }
  .contact__links span {
    color: var(--accent);
    margin: 0 0.6em;
  }
  .contact__city {
    margin: 2.6rem 0 0;
  }
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(100px, 13vw, 180px);
    padding-block: 1.8rem;
    border-top: 1px solid var(--rule);
    font-size: 0.64rem;
  }
  .footer__credit {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }
  .footer__credit :global(img) {
    height: 20px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.5;
    transition: opacity 0.4s;
  }
  .footer__credit:hover :global(img) {
    opacity: 0.9;
  }
</style>
